# ---- build outputs -------------------------------------------------------
/bfc.exe
/bfc
*.o
*.obj
*.out

# ---- generated code / test harness scratch -------------------------------
# The assembly under tests/asm is produced by bfc and is regenerated by
# tests/run_tests.ps1, so it is not tracked.
/tests/bin/
/tests/cross/
/tests/asm/
/tests/bf/*.s

# ---- local work area ------------------------------------------------------
# .dsh holds private notes, daily reports, the knowledge base and planning.
# It is a local workspace and must never be committed.
/.dsh/

# ---- editors / operating systems -----------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
